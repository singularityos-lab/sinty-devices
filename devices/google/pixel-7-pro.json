{
  "schema": 1,
  "id": "google/pixel-7-pro",
  "vendor": "Google",
  "model": "Pixel 7 Pro",
  "arch": "aarch64",
  "min_flash_version": "0.2.0",
  "match": {
    "compatible": ["google,gs201-cheetah"],
    "usb": [
      { "mode": "fastboot", "vid": "18d1", "pid": "4ee0" }
    ]
  },
  "install": {
    "method": "fastboot",
    "unlock": "flashing unlock",
    "partitions": [
      { "name": "boot_a", "source": "boot" },
      { "name": "init_boot_a", "source": "init_boot" },
      { "name": "vendor_boot_a", "source": "vendor_boot" },
      { "name": "vendor_kernel_boot_a", "source": "vendor_kernel_boot" },
      { "name": "dtbo_a", "source": "dtbo" },
      { "name": "userdata", "source": "data" }
    ]
  },
  "boot": {
    "format": "android-v4",
    "images": ["boot", "init_boot", "vendor_boot", "vendor_kernel_boot", "dtbo"],
    "dtb": "exynos/google/gs201-cheetah-full.dtb",
    "soc_ids": [
      { "name": "b0", "id": "0x9855001" },
      { "name": "a0", "id": "0x9855000" }
    ],
    "bootargs": "console=tty0 loglevel=4 quiet panic=10 clk_ignore_unused pd_ignore_unused rdinit=/init mem_sleep_default=s2idle vt.global_cursor_default=0 sing.roothash=anchor sing.datapart=userdata lsm=landlock,yama,bpf max77759_charger.default_ilim_ua=500000 max77759_charger.temp_guard=1 firmware_class.path=/var/lib/sinty/firmware",
    "vendor_cmdline": "console=tty0 earlycon=exynos4210,0x10A00000 clk_ignore_unused pd_ignore_unused printk.devkmsg=on bootconfig",
    "vendor_page_size": 2048,
    "os_version": "17.0.0",
    "os_patch_level": "2026-07",
    "dtbo": { "board_id": "0x30306", "board_rev": "0x10000", "page_size": 4096 },
    "avb": {
      "rollback_index": 1783209600,
      "security_patch": "2026-07-05",
      "footers": [
        { "partition": "boot", "size": "0x4000000" },
        { "partition": "init_boot", "size": "0x800000" }
      ]
    }
  },
  "firmware": {
    "preserve": true,
    "restore": "https://developers.google.com/android/images#cheetah",
    "extract": {
      "partition": "vendor",
      "files": [
        { "from": "firmware/fw_bcmdhd.bin", "to": "brcm/brcmfmac4389c1-pcie.google,gs201-cheetah.bin" },
        { "from": "firmware/bcmdhd.cal", "to": "brcm/brcmfmac4389c1-pcie.google,gs201-cheetah.txt" },
        { "from": "firmware/bcmdhd_clm.blob", "to": "brcm/brcmfmac4389c1-pcie.google,gs201-cheetah.clm_blob" },
        { "from": "firmware/brcm/BCM.hcd", "to": "brcm/BCM.google,gs201-cheetah.hcd" },
        { "from": "firmware/aoc.bin", "to": "aoc.bin" },
        { "from": "firmware/cs40l26.wmfw", "to": "cs40l26.wmfw" },
        { "from": "firmware/cs40l26.bin", "to": "cs40l26.bin" },
        { "from": "firmware/cs40l26-svc.bin", "to": "cs40l26-svc.bin" },
        { "from": "firmware/cs40l26-dvl.bin", "to": "cs40l26-dvl.bin" },
        { "from": "firmware/cs40l26-calib.wmfw", "to": "cs40l26-calib.wmfw" },
        { "from": "firmware/cs35l41-dsp1-spk-prot.wmfw", "to": "cirrus/cs35l41-dsp1-spk-prot-cheetah.wmfw" },
        { "from": "firmware/cs35l41-dsp1-spk-prot.bin", "to": "cirrus/cs35l41-dsp1-spk-prot-cheetah-top.bin" },
        { "from": "firmware/R-cs35l41-dsp1-spk-prot.bin", "to": "cirrus/cs35l41-dsp1-spk-prot-cheetah-bottom.bin" },
        { "from": "firmware/fast_switch3.txt", "to": "cirrus/cs35l41-cheetah-top-media-delta.txt" },
        { "from": "firmware/fast_switch4.txt", "to": "cirrus/cs35l41-cheetah-bottom-media-delta.txt" }
      ],
      "generate": [
        { "name": "camera", "tool": "/usr/libexec/sinty/extract-camera-data", "input": "apex/com.google.pixel.camera.hal.apex", "to": "omamobile/camera", "args": ["--apex", "{input}", "-d", "{output}"] }
      ]
    }
  },
  "notes": [
    "Unlock the bootloader first: enable OEM unlocking in Android's developer options, then run the unlock from fastboot. Unlocking wipes the phone.",
    "Sinty replaces the slot A boot images and userdata. The bootloader, modem, persist and EFS partitions stay as shipped, so the phone keeps its IMEI and calibration.",
    "Android comes back by flashing the factory image for cheetah."
  ]
}
